DATABASE_URL=postgresql://user:pass@localhost:5432/lms
PORT=3000
JWT_SECRET=supersecret
JWT_EXPIRES=365d

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CORE_API_KEY=

# Bunny Stream CDN Token Authentication
# This is the "Token authentication key" from Bunny Stream Security settings.
# SERVER SIDE ONLY. Never expose it to the mobile/web client.
BUNNY_CDN_TOKEN_KEY=
BUNNY_CDN_TOKEN_TTL_SECONDS=300

# Video playback/offline access
VIDEO_PLAYBACK_TTL_SECONDS=300
VIDEO_DOWNLOAD_TTL_SECONDS=600
OFFLINE_LICENSE_TTL_DAYS=7
OFFLINE_LICENSE_PRIVATE_KEY_PEM=
OFFLINE_LICENSE_PUBLIC_KEY_PEM=
OFFLINE_LICENSE_KEY_ID=default
VIDEO_DEVICE_LIMIT=1
VIDEO_PLAYBACK_RATE_LIMIT=20
VIDEO_DOWNLOAD_RATE_LIMIT=5
VIDEO_RENEW_RATE_LIMIT=10
VIDEO_CHALLENGE_RATE_LIMIT=40
VIDEO_RATE_LIMIT_WINDOW_SECONDS=300
VIDEO_APP_ONLY_ENABLED=false
VIDEO_PLAY_INTEGRITY_ENFORCE=false
VIDEO_EDGE_GATEWAY_ENABLED=false
# Audit mode (false): device signatures are verified and logged but not required.
# Enforce (true): student playback/download sessions require a valid Keystore signature.
VIDEO_DEVICE_SIGNATURE_ENFORCE=false
VIDEO_DEVICE_KEY_REQUIRED=false
VIDEO_PLAYBACK_CHALLENGE_TTL_SECONDS=60
VIDEO_PLAYBACK_SESSION_TTL_SECONDS=600
VIDEO_EDGE_ORIGIN_TTL_SECONDS=120
# Public origin of the Bunny edge gateway (infra/bunny-video-edge).
# Required for offline downloads: download sessions only ever return a
# gateway URL plus a per-session header token, never a direct Bunny URL.
VIDEO_GATEWAY_BASE_URL=
# Bunny Stream pull-zone host that serves HLS (e.g. vz-xxxxxxxx-xxx.b-cdn.net).
# The edge gateway signs origin requests against this host. If empty it is
# learned once from Bunny's play API.
BUNNY_STREAM_CDN_HOSTNAME=
VIDEO_EDGE_SHARED_SECRET=
GOOGLE_PLAY_INTEGRITY_PROJECT_NUMBER=

# Students sign in from one device only (the device the account was created
# on, or for older accounts the first device that signs in or uses an existing
# session). Set to false only temporarily.
STUDENT_SINGLE_DEVICE_ENFORCE=true
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_PLAY_PACKAGE_NAME=com.YamanKartal.coursaty_app
VIDEO_PLAY_INTEGRITY_REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
VIDEO_PLAY_INTEGRITY_MAX_AGE_MS=120000

# Bunny Storage
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_PUBLIC_HOST=
# Legacy alias (optional): CDN_Hostname=your-pull-zone.b-cdn.net

# Firebase Admin (JSON stringified)
FIREBASE_SERVICE_ACCOUNT_JSON=
REDIS_URL=redis://localhost:6379
