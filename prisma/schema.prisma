generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  STUDENT
  TEACHER
  ADMIN
}


enum CodeStatus {
  ACTIVE
  USED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum NotificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           BigInt   @id @default(autoincrement())
  phone        String   @unique
  password     String
  userableId   BigInt
  userableType UserType
  gender       Gender   @default(MALE)
  fcmToken     String?
  status       String   @default("active")
  createdAt    DateTime @default(now())

  videoInteractions VideoInteraction[]
  createdNotifications Notification[] @relation("CreatedNotifications")

  @@index([userableId, userableType])
}

model Student {
  id           BigInt   @id @default(autoincrement())
  name         String
  universityNumber String? @unique
  universityId BigInt
  provinceId  BigInt
  collegeId    BigInt
  departmentId BigInt
  collegeYearId BigInt
  createdAt    DateTime @default(now())

  university University @relation(fields: [universityId], references: [id])
  province  Province  @relation(fields: [provinceId], references: [id])
  college    College    @relation(fields: [collegeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  collegeYear CollegeYear @relation(fields: [collegeYearId], references: [id])
  subscriptions StudentSubscription[]
  teacherLikes   TeacherLike[]
  usedCodes       Code[] @relation("UsedCodes")

  @@index([universityId])
  @@index([provinceId])
  @@index([collegeId])
  @@index([collegeYearId])
}

model Teacher {
  id                 BigInt   @id @default(autoincrement())
  name               String
  description        String?
  image              String?
  likesCount         Int      @default(0)
  createdAt          DateTime @default(now())

  affiliations   TeacherAffiliation[]
  courses        Course[]
  teacherLikes   TeacherLike[]
  allowedSubjects TeacherSubjectPermission[]
  withdrawals    TeacherWithdrawal[]
}

model TeacherWithdrawal {
  id        BigInt           @id @default(autoincrement())
  teacherId BigInt
  amount    Decimal          @db.Decimal(10, 2)
  status    WithdrawalStatus @default(APPROVED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([createdAt])
}

model Admin {
  id        BigInt   @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  approvedNotifications Notification[]
  approvedCourses Course[]
}

model University {
  id        BigInt   @id @default(autoincrement())
  provinceId BigInt
  name      String
  createdAt DateTime @default(now())
  province Province @relation(fields: [provinceId], references: [id])
  colleges  College[]
  courses   Course[]
  pointsOfSales PointOfSale[]
  students  Student[]
  teacherAffiliations TeacherAffiliation[]

  @@index([provinceId])
}

model Province {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  universities University[]
  pointsOfSales PointOfSale[]
  students Student[]
}

model College {
  id           BigInt   @id @default(autoincrement())
  universityId BigInt
  name         String

  university University @relation(fields: [universityId], references: [id])
  departments Department[]
  collegeYears CollegeYear[]
  subjects    Subject[]
  courses     Course[]
  advertisements Advertisement[]
  notifications Notification[]
  students   Student[]
  teacherAffiliations TeacherAffiliation[]

  @@index([universityId])
}

model TeacherAffiliation {
  id           BigInt   @id @default(autoincrement())
  teacherId    BigInt
  universityId BigInt
  collegeId    BigInt
  departmentId BigInt?
  createdAt    DateTime @default(now())

  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id])
  college    College    @relation(fields: [collegeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([universityId])
  @@index([collegeId])
  @@index([departmentId])
}

model Advertisement {
  id        BigInt   @id @default(autoincrement())
  collegeId BigInt
  title     String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Notification {
  id           BigInt             @id @default(autoincrement())
  title        String
  description  String
  status       NotificationStatus @default(PENDING)
  createdById  BigInt
  collegeId    BigInt
  departmentId BigInt?
  approvedById BigInt?
  approvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy  User       @relation("CreatedNotifications", fields: [createdById], references: [id])
  college    College    @relation(fields: [collegeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  approvedBy Admin?     @relation(fields: [approvedById], references: [id])

  @@index([createdById])
  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
}

model Department {
  id         BigInt   @id @default(autoincrement())
  collegeId  BigInt
  name       String

  college  College  @relation(fields: [collegeId], references: [id])
  collegeYears    CollegeYear[]
  subjects Subject[]
  students Student[]
  notifications Notification[]
  teacherAffiliations TeacherAffiliation[]
  courses Course[]

  @@index([collegeId])
}

model AcademicYear {
  id         BigInt   @id @default(autoincrement())
  yearNumber Int      @unique
  yearName   String

  collegeYears CollegeYear[]
}

model CollegeYear {
  id             BigInt   @id @default(autoincrement())
  collegeId      BigInt
  departmentId   BigInt?
  academicYearId BigInt
  isActive       Boolean  @default(true)

  college      College      @relation(fields: [collegeId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  students     Student[]
  courses      Course[]
  subjects     Subject[]
  @@index([collegeId])
  @@index([departmentId])
  @@index([academicYearId])
}

model Season {
  id           BigInt   @id @default(autoincrement())
  seasonName   String
  seasonNumber Int
  courses      Course[]
  subjects     Subject[]
}

model Subject {
  id           BigInt   @id @default(autoincrement())
  collegeId    BigInt
  collegeYearId       BigInt?
  seasonId     BigInt?
  departmentId BigInt?
  subjectName  String
  isProgram    Boolean  @default(false)

  college    College    @relation(fields: [collegeId], references: [id])
  collegeYear       CollegeYear?      @relation(fields: [collegeYearId], references: [id])
  season     Season?    @relation(fields: [seasonId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courses    Course[]
  teacherPermissions TeacherSubjectPermission[]

  @@index([collegeId])
  @@index([collegeYearId])
  @@index([seasonId])
  @@index([departmentId])
}

model Course {
  id                    BigInt    @id @default(autoincrement())
  teacherId             BigInt
  subjectId             BigInt?
  collegeYearId                BigInt?
  seasonId              BigInt?
  universityId          BigInt?
  collegeId             BigInt?
  departmentId          BigInt?
  categoryId            BigInt?
  name                  String
  description           String?
  imageUrl              String?
  price                 Decimal   @db.Decimal(10, 2)
  duration              Int       @default(2)
  isFree                Boolean   @default(false)
  expiresAt             DateTime?
  introVideoUrl         String?
  discussionGroupUrl    String?
  status                CourseStatus @default(PENDING)
  teacherPercentage     Decimal   @default(0.0)
  approvedById          BigInt?
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())

  teacher        Teacher   @relation(fields: [teacherId], references: [id])
  subject        Subject?  @relation(fields: [subjectId], references: [id])
  collegeYear           CollegeYear?     @relation(fields: [collegeYearId], references: [id])
  season         Season?   @relation(fields: [seasonId], references: [id])
  university     University? @relation(fields: [universityId], references: [id])
  college        College?    @relation(fields: [collegeId], references: [id])
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category       CourseCategory? @relation(fields: [categoryId], references: [id])
  approvedBy     Admin?    @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  lectures       Lecture[]
  codeGroups     CodeGroup[]
  subscriptions  StudentSubscription[]

  @@index([teacherId])
  @@index([subjectId])
  @@index([collegeYearId])
  @@index([seasonId])
  @@index([universityId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([status])
  @@index([approvedById])
}

model CourseCategory {
  id        BigInt   @id @default(autoincrement())
  name      String
  sortOrder Int?
  requiresAcademicLinks Boolean @default(true)
  isProgram Boolean @default(false)
  createdAt DateTime @default(now())

  courses Course[]

  @@unique([name])
}

model Lecture {
  id         BigInt   @id @default(autoincrement())
  courseId   BigInt
  title      String
  description String?
  imageUrl   String?
  sortOrder  Int?

  course      Course      @relation(fields: [courseId], references: [id])
  videos      Video[]
  files       LectureFile[]
  questions   Question[]

  @@index([courseId])
}

model Video {
  id              BigInt   @id @default(autoincrement())
  lectureId       BigInt
  videoName       String
  videoUrl        String
  durationSeconds Int?
  viewsCount      Int      @default(0)
  isFree          Boolean  @default(false)

  lecture       Lecture            @relation(fields: [lectureId], references: [id])
  interactions  VideoInteraction[]
  segments      VideoSegment[]

  @@index([lectureId])
}

model VideoSegment {
  id            BigInt   @id @default(autoincrement())
  videoId       BigInt
  segmentName   String
  startSeconds  Int
  endSeconds    Int
  sortOrder     Int?
  createdAt     DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([startSeconds, endSeconds])
}

model VideoInteraction {
  id        BigInt   @id @default(autoincrement())
  videoId   BigInt
  userId    BigInt
  isLiked   Boolean  @default(false)
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([videoId])
  @@index([userId])
  @@index([rating])
}

model TeacherLike {
  id        BigInt   @id @default(autoincrement())
  teacherId BigInt
  studentId BigInt

  teacher Teacher @relation(fields: [teacherId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([teacherId, studentId])
  @@index([studentId])
}

model TeacherSubjectPermission {
  teacherId BigInt
  subjectId BigInt
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model LectureFile {
  id        BigInt   @id @default(autoincrement())
  lectureId BigInt
  fileName  String
  fileUrl   String
  fileType  String?
  isFree    Boolean  @default(false)

  lecture Lecture @relation(fields: [lectureId], references: [id])

  @@index([lectureId])
}

model Question {
  id           BigInt   @id @default(autoincrement())
  lectureId    BigInt
  questionText String?
  imageUrl     String?
  explanation  String?
  questionType String   @default("multiple_choice") // multiple_choice, true_false, short_answer
  points       Int      @default(1)
  sortOrder    Int?

  lecture  Lecture       @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  options    QuestionOption[]

  @@index([lectureId])
}

model QuestionOption {
  id         BigInt  @id @default(autoincrement())
  questionId BigInt
  optionText String
  isCorrect  Boolean @default(false)
  sortOrder  Int?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model CodeGroup {
  id                  BigInt   @id @default(autoincrement())
  courseId            BigInt
  batchName           String
  discountPercentage  Decimal  @db.Decimal(5, 2) @default(0.00)
  createdAt           DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])
  codes  Code[]

  @@index([courseId])
}

model Code {
  id              BigInt   @id @default(autoincrement())
  codeGroupId     BigInt
  codeValue       String   @unique
  status          CodeStatus @default(ACTIVE)
  allowedUniversityNumber String?
  validForDays    Int?
  validUntil      DateTime?
  usageLimit      Int?
  usageCount      Int      @default(0)
  usedByStudentId BigInt?
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  codeGroup CodeGroup @relation(fields: [codeGroupId], references: [id])
  usedBy    Student?  @relation("UsedCodes", fields: [usedByStudentId], references: [id])

  @@index([codeGroupId])
  @@index([usedByStudentId])
}

model StudentSubscription {
  id         BigInt   @id @default(autoincrement())
  studentId  BigInt
  courseId   BigInt
  finalPrice Decimal  @db.Decimal(10, 2)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([createdAt])
}
model PointOfSale {
  id           BigInt   @id @default(autoincrement())
  universityId BigInt
  provinceId  BigInt
  name         String
  address      String
  phone        String?
  description  String?
  image        String?
  imageLocation String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id])
  province  Province  @relation(fields: [provinceId], references: [id])

  @@index([universityId])
  @@index([provinceId])
}

model CustomerService {
  id                BigInt   @id @default(autoincrement())
  technicalSupportPhone String
  contactSupportPhone   String
  whatsappUrl       String?
  telegramUrl       String?
  facebookUrl       String?
  instagramUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AppDescription {
  id          BigInt   @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}